# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartdukaan?schema=public"

# Authentication
JWT_SECRET="your_jwt_secret_key_change_in_production"

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Client URL
CLIENT_URL="http://localhost:5173"

# Optional WhatsApp Cloud API (SmartDukan uses 100% free browser wa.me deep-links by default)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
